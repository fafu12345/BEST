# Local Supabase: use the URL and keys printed by `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_ or commit real credentials.
SUPABASE_SERVICE_ROLE_KEY=

# Backups: supply ESTATEMATCH_BACKUP_PASSWORD only to the backup/recovery process.
# Do not store that password in this file or expose it with NEXT_PUBLIC_.
# See docs/backup-recovery.md for Windows DPAPI and scheduled-task setup.
